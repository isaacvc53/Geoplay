# Copia este archivo a .env y rellénalo:  cp .env.example .env
# Genera valores seguros con:  openssl rand -hex 32

POSTGRES_USER=geoplay
POSTGRES_PASSWORD=
POSTGRES_DB=geoplay

# Mínimo 32 caracteres. Si falta o es más corta, el backend NO arranca.
SECRET_KEY=

# Emails con permisos de administración, separados por comas.
ADMIN_EMAILS=tu@email.com
