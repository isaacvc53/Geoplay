+    assert by_slug["espana"]["me"]["best_time_seconds"] == 45
+    assert by_slug["espana"]["me"]["games_played"] == 2
+    assert by_slug["espana"]["friend"]["best_percentage"] == 66.7
+    assert by_slug["francia"]["me"] is None
