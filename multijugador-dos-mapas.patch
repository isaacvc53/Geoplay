+@media (max-width:720px){
+  /* Phone: my map on top, the rival's right below, each one half of the height. */
+  .country-page.mpg .maps{ flex-direction:column; }
+  .country-page.mpg .rival-area{ border-left:0; }
+  .country-page.mpg .map-tag{ top:8px; right:8px; font-size:10px; padding:2px 7px; }
+}
+@media (max-height:520px) and (orientation:landscape){
+  /* Phone on its side: back to side by side. */
+  .country-page.mpg .maps{ flex-direction:row; }
+  .country-page.mpg .rival-area{ border-left:1px solid var(--line); }
+}
